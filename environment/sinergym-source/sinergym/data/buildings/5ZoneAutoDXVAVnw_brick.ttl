bldg:coil_Main_Cooling_Coil_1 a brick:Direct_Expansion_Cooling_Coil ;
    rdfs:label "Main Cooling Coil 1" ;
    brick:feeds bldg:coil_Main_heating_Coil_1 .

bldg:point_Direct_Solar_Radiation a brick:Solar_Irradiance_Sensor ;
    rdfs:label "Direct Solar Radiation" ;
    brick:hasUnit unit:W-PER-M2 ;
    ref:hasExternalReference bldg:timeseries_ref_sinergym_direct_solar_radiation .

