    rdfs:label "Return-Plenum-1" ;
    brick:feeds bldg:ahu_VAV_Sys_1 ;
    brick:hasLocation bldg:zone_PLENUM_1 .

bldg:site_CHICAGO_IL_USA_TMY2_94846 a brick:Site ;
    rdfs:label "CHICAGO_IL_USA TMY2-94846" ;
    brick:hasPart bldg:building_id_5ZoneAutoDXVAVnw,
        bldg:weather_Site_Weather_Station ;
    brick:latitude 4.178e+01 ;
    brick:longitude -8.775e+01 .

