@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

bldg:air_loop_VAV_Sys_1 a brick:Air_Loop ;
    rdfs:label "VAV Sys 1" ;
    rdfs:comment "Central air-side path: outdoor-air mixing section -> main DX cooling coil -> main heating coil -> supply fan -> VAV dampers -> VAV reheat coils -> served zones. Return path: served zones -> return plenum -> VAV Sys 1. Served zones: SPACE1-1, SPACE2-1, SPACE3-1, SPACE4-1, SPACE5-1." ;
    brick:hasLocation bldg:building_id_5ZoneAutoDXVAVnw ;
    brick:hasPart bldg:ahu_VAV_Sys_1,
        bldg:vav_SPACE1_1_VAV_Reheat,
        bldg:vav_SPACE2_1_VAV_Reheat,
        bldg:vav_SPACE3_1_VAV_Reheat,
        bldg:vav_SPACE4_1_VAV_Reheat,
        bldg:vav_SPACE5_1_VAV_Reheat ;
    brick:hasPoint bldg:point_HVAC_Electricity_Energy .

bldg:equipment_SPACE1_1_ElecEq_1 a brick:Electrical_Equipment ;
    rdfs:label "SPACE1-1 ElecEq 1" ;
    rdfs:comment "Derived from EnergyPlus ElectricEquipment object; design_equipment_w=1056.000" ;
    brick:hasLocation bldg:zone_SPACE1_1 .

