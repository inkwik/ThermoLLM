bldg:return_mixer_East_Return_Air_Mixer a brick:HVAC_Equipment ;
    rdfs:label "East Return Air Mixer" ;
    rdfs:comment "EnergyPlus AirLoopHVAC:ZoneMixer on this zone's return-air path." ;
    brick:feeds bldg:ahu_East_Zone_Air_System .

bldg:return_mixer_Zone_Return_Air_Mixer a brick:HVAC_Equipment ;
