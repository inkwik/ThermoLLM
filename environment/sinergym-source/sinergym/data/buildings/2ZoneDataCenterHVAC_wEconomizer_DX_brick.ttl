@prefix bldg: <https://example.org/sinergym/2zone-datacenter-dx#> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix ext: <urn:sinergym-datacenter-dx#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://w3id.org/rec#> .
@prefix ref: <https://brickschema.org/schema/Brick/ref#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

bldg:air_loop_East_Zone_Air_System a brick:Air_Loop ;
    rdfs:label "East Zone Air System" ;
    rec:includes bldg:ahu_East_Zone_Air_System ;
    ext:hasAirHandlingUnit bldg:ahu_East_Zone_Air_System .

bldg:air_loop_West_Zone_Air_System a brick:Air_Loop ;
    rdfs:label "West Zone Air System" ;
    rec:includes bldg:ahu_West_Zone_Air_System ;
    ext:hasAirHandlingUnit bldg:ahu_West_Zone_Air_System .

bldg:ite_EastDataCenter_Equip a brick:Electrical_Equipment ;
    rdfs:label "EastDataCenter_Equip" ;
    rdfs:comment "Air-cooled IT equipment; design W/m2=200; CPU loading schedule=Data Center CPU Loading Schedule." ;
    brick:hasLocation bldg:zone_East_Zone ;
    brick:hasPoint bldg:point_East_ITE_CPU_Electricity_Rate .

bldg:ite_WestDataCenter_Equip a brick:Electrical_Equipment ;
    rdfs:label "WestDataCenter_Equip" ;
    rdfs:comment "Air-cooled IT equipment; design W/m2=200; CPU loading schedule=Data Center CPU Loading Schedule." ;
    brick:hasLocation bldg:zone_West_Zone ;
    brick:hasPoint bldg:point_West_ITE_CPU_Electricity_Rate .

bldg:site_CHICAGO_IL_USA_TMY2_94846 a brick:Site ;
    rdfs:label "CHICAGO_IL_USA TMY2-94846" ;
    rdfs:comment "EnergyPlus template site; actual outdoor weather comes from the selected Sinergym EPW (hot = Arizona)." ;
    brick:hasPart bldg:building_2ZoneDataCenterHVAC_wEconomizer_DX ;
    brick:latitude 41.78 ;
    brick:longitude -87.75 .

bldg:thermostat_East_Zone_Thermostat a brick:Thermostat ;
    rdfs:label "East Zone Thermostat" ;
    brick:hasLocation bldg:zone_East_Zone ;
    brick:hasPoint bldg:point_East_Cooling_Setpoint,
        bldg:point_East_Heating_Setpoint .

bldg:thermostat_West_Zone_Thermostat a brick:Thermostat ;
    rdfs:label "West Zone Thermostat" ;
    brick:hasLocation bldg:zone_West_Zone ;
    brick:hasPoint bldg:point_West_Cooling_Setpoint,
        bldg:point_West_Heating_Setpoint .

bldg:weather_Outdoor_Weather_Station a brick:Weather_Station ;
    rdfs:label "Outdoor Weather Station" ;
    brick:hasLocation bldg:building_2ZoneDataCenterHVAC_wEconomizer_DX ;
    brick:hasPoint bldg:point_Diffuse_Solar_Radiation,
        bldg:point_Direct_Solar_Radiation,
        bldg:point_Outdoor_Air_Humidity,
        bldg:point_Outdoor_Air_Temperature,
        bldg:point_Site_Wind_Direction,
        bldg:point_Site_Wind_Speed .

ext:adjacentTo a rdf:Property .

ext:energyPlusObjectType a rdf:Property .

ext:hasAirHandlingUnit a rdf:Property .

ext:hasEnvelopeSurface a rdf:Property .

ext:outsideBoundaryCondition a rdf:Property .

ext:returnPathFrom a rdf:Property .

unit:DEG a qudt:Unit .

unit:J a qudt:Unit .

unit:M-PER-SEC a qudt:Unit .

bldg:equipment_East_Zone_OA_System a brick:HVAC_Equipment ;
    rdfs:label "East Zone OA System" ;
    brick:feeds bldg:equipment_East_Zone_Supply_Fan ;
    ext:energyPlusObjectType "AirLoopHVAC:OutdoorAirSystem" .

bldg:equipment_West_Zone_OA_System a brick:HVAC_Equipment ;
    rdfs:label "West Zone OA System" ;
    brick:feeds bldg:equipment_West_Zone_Supply_Fan ;
    ext:energyPlusObjectType "AirLoopHVAC:OutdoorAirSystem" .

bldg:plenum_East_Supply_Plenum a brick:HVAC_Equipment ;
    rdfs:label "East Supply Plenum" ;
    rdfs:comment "EnergyPlus AirLoopHVAC:SupplyPlenum; serves the zone inlet path." ;
    brick:feeds bldg:vav_East_Zone_VAV_System .

bldg:plenum_West_Supply_Plenum a brick:HVAC_Equipment ;
    rdfs:label "West Supply Plenum" ;
    rdfs:comment "EnergyPlus AirLoopHVAC:SupplyPlenum; serves the zone inlet path." ;
    brick:feeds bldg:vav_West_Zone_VAV_System .

bldg:point_Diffuse_Solar_Radiation a brick:Solar_Irradiance_Sensor ;
    rdfs:label "Diffuse Solar Radiation" ;
    rdfs:comment "Runtime value from Sinergym and the selected EPW." ;
    brick:hasUnit unit:W-PER-M2 ;
    ref:hasExternalReference bldg:timeseries_ref_diffuse_solar_radiation .

bldg:point_Direct_Solar_Radiation a brick:Solar_Irradiance_Sensor ;
    rdfs:label "Direct Solar Radiation" ;
    rdfs:comment "Runtime value from Sinergym and the selected EPW." ;
    brick:hasUnit unit:W-PER-M2 ;
    ref:hasExternalReference bldg:timeseries_ref_direct_solar_radiation .

bldg:point_East_DX_Sensible_Cooling_Rate a brick:Sensor ;
    rdfs:label "East DX Sensible Cooling Rate" ;
    rdfs:comment "Observed DX cooling rate in W." ;
    brick:hasUnit unit:W ;
    ref:hasExternalReference bldg:timeseries_ref_east_dx_sensible_cooling_rate .

bldg:point_East_DX_Total_Cooling_Rate a brick:Sensor ;
    rdfs:label "East DX Total Cooling Rate" ;
    rdfs:comment "Observed DX cooling rate in W." ;
    brick:hasUnit unit:W ;
    ref:hasExternalReference bldg:timeseries_ref_east_dx_total_cooling_rate .

bldg:point_East_ITE_CPU_Electricity_Rate a brick:Sensor ;
    rdfs:label "East ITE CPU Electricity Rate" ;
    rdfs:comment "Actual per-zone ITE CPU electric rate in W; internal heat source, not HVAC energy." ;
    brick:hasUnit unit:W ;
    ref:hasExternalReference bldg:timeseries_ref_east_ite_cpu_electricity_rate .

bldg:point_East_Mean_Radiant_Temperature a brick:Sensor ;
    rdfs:label "East Mean Radiant Temperature" ;
    rdfs:comment "Zone mean radiant temperature in C." ;
    brick:hasUnit unit:DEG_C ;
    ref:hasExternalReference bldg:timeseries_ref_east_zone_mean_radiant_temperature .

bldg:point_East_Return_Air_Temperature a brick:Sensor ;
    rdfs:label "East Return Air Temperature" ;
    rdfs:comment "Return node air temperature in C." ;
    brick:hasUnit unit:DEG_C ;
    ref:hasExternalReference bldg:timeseries_ref_east_return_temperature .

bldg:point_East_Supply_Air_Mass_Flow a brick:Sensor ;
    rdfs:label "East Supply Air Mass Flow" ;
    rdfs:comment "Zone inlet mass flow rate in kg/s." ;
    brick:hasUnit unit:KiloGM-PER-SEC ;
    ref:hasExternalReference bldg:timeseries_ref_east_mass_flow_rate .

bldg:point_East_Supply_Air_Temperature a brick:Sensor ;
    rdfs:label "East Supply Air Temperature" ;
    rdfs:comment "Zone inlet node air temperature in C." ;
    brick:hasUnit unit:DEG_C ;
    ref:hasExternalReference bldg:timeseries_ref_east_supply_temperature .

bldg:point_East_Zone_Air_Humidity a brick:Zone_Air_Humidity_Sensor ;
    rdfs:label "East Zone Air Humidity" ;
    rdfs:comment "Zone relative humidity in percent." ;
    brick:hasUnit unit:PERCENT ;
    ref:hasExternalReference bldg:timeseries_ref_east_zone_air_humidity .

bldg:point_East_Zone_Air_Temperature a brick:Zone_Air_Temperature_Sensor ;
    rdfs:label "East Zone Air Temperature" ;
    rdfs:comment "Controlled zone air temperature in C." ;
    brick:hasUnit unit:DEG_C ;
    ref:hasExternalReference bldg:timeseries_ref_east_zone_air_temperature .

bldg:point_Facility_HVAC_Electricity_Demand a brick:Sensor ;
    rdfs:label "Facility HVAC Electricity Demand" ;
    rdfs:comment "Facility-wide HVAC demand rate in W, reported for the completed interval." ;
    brick:hasUnit unit:W ;
    ref:hasExternalReference bldg:timeseries_ref_HVAC_electricity_demand_rate .

bldg:point_Facility_HVAC_Electricity_Energy a brick:Electrical_Energy_Usage_Sensor ;
    rdfs:label "Facility HVAC Electricity Energy" ;
    rdfs:comment "Energy consumed in the just-completed 15-minute interval, in joules; divide by 3,600,000 for kWh.",
        "Facility-wide HVAC meter; do not attribute this energy to either zone separately." ;
    brick:hasUnit unit:J ;
    ref:hasExternalReference bldg:timeseries_ref_HVAC_electricity_energy_j .

bldg:point_Outdoor_Air_Humidity a brick:Outside_Air_Humidity_Sensor ;
    rdfs:label "Outdoor Air Humidity" ;
    rdfs:comment "Runtime value from Sinergym and the selected EPW." ;
    brick:hasUnit unit:PERCENT ;
    ref:hasExternalReference bldg:timeseries_ref_outdoor_humidity .

bldg:point_Outdoor_Air_Temperature a brick:Outside_Air_Temperature_Sensor ;
    rdfs:label "Outdoor Air Temperature" ;
    rdfs:comment "Runtime value from Sinergym and the selected EPW." ;
    brick:hasUnit unit:DEG_C ;
    ref:hasExternalReference bldg:timeseries_ref_outdoor_temperature .

bldg:point_Site_Wind_Direction a brick:Sensor ;
    rdfs:label "Site Wind Direction" ;
    rdfs:comment "Runtime value from Sinergym and the selected EPW." ;
    brick:hasUnit unit:DEG ;
    ref:hasExternalReference bldg:timeseries_ref_wind_direction .

bldg:point_Site_Wind_Speed a brick:Wind_Speed_Sensor ;
