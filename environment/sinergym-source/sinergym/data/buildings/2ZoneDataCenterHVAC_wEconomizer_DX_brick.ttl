    brick:hasUnit unit:M-PER-SEC ;
    ref:hasExternalReference bldg:timeseries_ref_wind_speed .

bldg:point_West_DX_Sensible_Cooling_Rate a brick:Sensor ;
    rdfs:label "West DX Sensible Cooling Rate" ;
    rdfs:comment "Observed DX cooling rate in W." ;
    brick:hasUnit unit:W ;
    ref:hasExternalReference bldg:timeseries_ref_west_dx_sensible_cooling_rate .

bldg:point_West_DX_Total_Cooling_Rate a brick:Sensor ;
